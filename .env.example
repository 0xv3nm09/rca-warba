RCA_PROFILE=local
RCA_LOG_LEVEL=INFO

# ---- Model routes -----------------------------------------------------------
# Defaults use the built-in deterministic providers so the stack runs anywhere
# with zero downloads. To use a real local model via Ollama:
#   LLM_EXTRACT_MODEL=qwen3:4b
#   LLM_EXTRACT_BASE_URL=http://host.docker.internal:11434/v1   (from containers)
#   LLM_DRAFT_MODEL=qwen3:4b
#   LLM_DRAFT_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_CLASSIFY_MODEL=qwen3:4b
#   LLM_CLASSIFY_BASE_URL=http://host.docker.internal:11434/v1
LLM_EXTRACT_MODEL=dummy-extractor
LLM_EXTRACT_BASE_URL=local
LLM_DRAFT_MODEL=dummy-drafter
LLM_DRAFT_BASE_URL=local
LLM_CLASSIFY_MODEL=dummy-classifier
LLM_CLASSIFY_BASE_URL=local
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_IS_EXTERNAL=false
LLM_API_KEY=

# ---- Embeddings -------------------------------------------------------------
# hash  : deterministic hashed n-gram embeddings, no downloads (prototype default)
# bge-m3: real multilingual embeddings (requires `uv sync --extra ml`)
EMBED_BACKEND=hash
EMBED_DIM=1024

# ---- Limits -----------------------------------------------------------------
LLM_MAX_CONCURRENCY=4
LLM_RPM=60
LLM_TPM=200000
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
USER_TOKENS_PER_HOUR=200000

# ---- Data -------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://rca:rca@localhost:5433/rca
REDIS_URL=redis://localhost:6379/0

# ---- Identity and security --------------------------------------------------
SESSION_TTL_MIN=30
JWT_SIGNING_KEY=dev-only-change-me
JWT_ISSUER=rca-local
JWT_AUDIENCE=rca-api
AUDIT_HMAC_KEY=dev-only-change-me
ADAPTERS=dummy
ALLOW_WRITES_TO_SOURCES=false

# ---- Free cloud API (optional; for reviewer demos with a real LLM) ----------
# Get a free key at https://console.groq.com/keys (2 minutes, no card needed).
# Then run:  cp .env.example .env   (edit the lines below)   make up
# Models that work well: llama-3.3-70b-versatile, qwen/qwen3-32b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_EXTRACT_MODEL=llama-3.3-70b-versatile
# LLM_EXTRACT_BASE_URL=https://api.groq.com/openai/v1
# LLM_DRAFT_MODEL=llama-3.3-70b-versatile
# LLM_DRAFT_BASE_URL=https://api.groq.com/openai/v1
# LLM_CLASSIFY_MODEL=llama-3.3-70b-versatile
# LLM_CLASSIFY_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=<paste your groq key here>
# NOTE: prototype data is synthetic, so a cloud API is safe here.
# In the Warba sandbox/pilot the same variables point at the in-bank endpoint
# (Ollama/vLLM) and no data leaves the bank - no code changes needed.
